generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubmissionStatus {
  pending
  published
  rejected
}

enum UserRole {
  user
}

enum ApprovalLogAction {
  skill_submitted
  skill_approved
  skill_rejected
  skill_deleted
  gitlab_sync_succeeded
  gitlab_sync_failed
  user_created
  user_enabled
  user_disabled
  password_changed
}

enum ApprovalActorType {
  admin
  user
  system
}

enum ApprovalTargetType {
  skill
  user
}

model Submission {
  id              String           @id
  slug            String
  displayName     String
  version         String
  namespace       String
  summary         String
  description     String
  changelog       String
  category        String
  tags            String[]
  authorName      String
  authorEmail     String
  status          SubmissionStatus
  createdAt       DateTime
  updatedAt       DateTime
  reviewedAt      DateTime?
  publishedAt     DateTime?
  reviewNotes     String?
  downloads       Int              @default(0)
  installsCurrent Int              @default(0)
  installsAllTime Int              @default(0)
  stars           Int              @default(0)
  featured        Boolean          @default(false)
  zipPath         String
  readme          String
  fileTree        Json
  fileCount       Int
  fingerprint     String
  frontmatter     Json

  @@index([slug, status])
  @@index([status, updatedAt])
  @@unique([slug, version])
}

model User {
  id           String   @id
  username     String   @unique
  email        String   @default("")
  displayName  String
  passwordHash String
  role         UserRole @default(user)
  roleLabel    String   @default("成员")
  organization String   @default("")
  createdAt    DateTime
  createdBy    String?
  disabled     Boolean  @default(false)
}

model Favorite {
  id        String   @id
  userId    String
  slug      String
  createdAt DateTime

  @@unique([userId, slug])
  @@index([slug])
}

model Rating {
  id        String   @id
  userId    String
  slug      String
  rating    Int
  createdAt DateTime
  updatedAt DateTime

  @@unique([userId, slug])
  @@index([slug])
}

model ApprovalLog {
  id          String              @id
  action      ApprovalLogAction
  actorType   ApprovalActorType
  actorName   String
  targetType  ApprovalTargetType
  targetId    String
  targetLabel String
  message     String
  createdAt   DateTime

  @@index([createdAt])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime
}
